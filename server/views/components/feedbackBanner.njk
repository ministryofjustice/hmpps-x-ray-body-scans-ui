{% macro feedbackBanner(params) %}
  <div class="hmpps-feedback-banner govuk-tag--yellow" data-module="hmpps-feedback-banner" data-testid="feedback-banner">
    <p class="govuk-body-s">
      {{ params.info }}
      <a href="{{ params.url }}" rel="noreferrer noopener" target="_blank">{{ params.urlText }}</a>
      {{ params.moreInfo }}
    </p>
  </div>
{% endmacro %}
