{% macro feedbackBanner(params) %}
  <div class="hmpps-feedback-banner" data-testid="feedback-banner">
    <p class="govuk-body-s">
      {{ params.info }}
      <a href="{{ params.url }}" rel="noreferrer noopener" target="_blank" data-testid="feedback-banner-link">{{ params.urlText }} </a>
      {{ params.moreInfo }}
    </p>
  </div>
{% endmacro %}
