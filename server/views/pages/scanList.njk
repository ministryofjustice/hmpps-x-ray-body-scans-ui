{% extends "partials/layout.njk" %}

{% from "govuk/components/table/macro.njk" import govukTable %}
{% from "govuk/components/button/macro.njk" import govukButton %}
{% from "dps/components/alert-flag/macro.njk" import alertFlag %}
{% from "components/infoBox.njk" import infoBox %}
{% from "components/resultTag.njk" import resultTag %}
{% from "components/scanCount.njk" import scanCount %}

{% set pageTitle = applicationName + " – X-ray body scans" %}
{% set breadcrumbs = [
  { text: 'Digital Prison Services', href: dpsHomeUrl },
  { text: prisoner.reversedDisplayName, href: prisoner | prisonerProfileUrl }
] %}

{% block content %}

  <h1 class="govuk-heading-l">X-ray body scans</h1>

  {{ govukButton({
    text: "Record a new scan",
    href: "/prisoner/" + prisonerNumber + "/record-scan"
  }) }}

  <hr class="govuk-section-break govuk-section-break--visible govuk-section-break--m">

  <div class="govuk-grid-row">
    <section class="govuk-grid-column-three-quarters" data-testid="scan-summary">
      <h2 class="govuk-heading-m">
        X-ray body scans recorded in {{ scanSummary.fromScanDate.getFullYear() }}
      </h2>

      {% if scanSummary.nomisCount %}
        {% set infoText %}
          {% if scanSummary.nomisCount == 1 %}
            1 scan does not have a result available
          {% else %}
            {{ scanSummary.nomisCount }} scans do not have a result available
          {% endif %}
        {% endset %}
        {{ infoBox({
          text: infoText,
          secondaryText: "Legacy records do not include a scan result. View the scan history details for additional information.",
          testid: "dps-scans-exist"
        }) }}
      {% endif %}

      <div class="scan-summary">
        <section class="scan-count__container" data-testid="scan-count">
          <h3 class="govuk-heading-s govuk-!-margin-bottom-2">
            Scans in {{ scanSummary.fromScanDate.getFullYear() }}
          </h3>

          {{ scanCount(scanSummary) }}
        </section>

        <section class="scan-outcome__container" data-testid="scan-outcome">
          <h3 class="govuk-heading-s govuk-!-margin-bottom-2">
            Scan results
          </h3>
          <ul class="govuk-list scan-outcome__list">
            <li class="scan-outcome scan-outcome--positive">
              <p>Items detected</p>
              <p class="scan-outcome__count">{{ scanSummary.positiveCount }}</p>
            </li>
            <li class="scan-outcome scan-outcome--inconclusive">
              <p>Inconclusive</p>
              <p class="scan-outcome__count">{{ scanSummary.inconclusiveCount }}</p>
            </li>
            <li class="scan-outcome scan-outcome--negative">
              <p>No item detected</p>
              <p class="scan-outcome__count">{{ scanSummary.negativeCount }}</p>
            </li>
          </ul>
        </section>
      </div>

    </section>

    <div class="govuk-grid-column-one-quarter">
      <section class="scan-alerts">
        <h2 class="govuk-heading-m">
          Scan alerts
        </h2>

        <ul class="govuk-list" data-testid="scan-alerts">
          {% for alert in alertFlags %}
            <li>
              {# href, if needed, could be:
              {% set alertDetailsUrl -%}
                {{ prisonerProfileUrl }}/prisoner/{{ prisoner.prisonerNumber }}/alerts//detail?ids={{ alert.id }}
              {%- endset %}
              #}
              {{ alertFlag({
                alert: alert
              }) }}
            </li>
          {% else %}
            <li data-testid="no-scan-alerts">No scan alerts</li>
          {% endfor %}
        </ul>
      </section>
    </div>
  </div>

  <hr class="govuk-section-break govuk-section-break--visible govuk-section-break--m">

  <section data-testid="scan-history">
    <h2 class="govuk-heading-m">X-ray body scan history</h2>

    <div class="govuk-tabs">
      <ul class="govuk-tabs__list">
        <li class="govuk-tabs__list-item {{ "govuk-tabs__list-item--selected" if not yearFilter }}">
          <a class="govuk-tabs__tab" href="?">
            This year’s scans
          </a>
        </li>
        {% for historicYear in historicYears %}
          <li class="govuk-tabs__list-item {{ "govuk-tabs__list-item--selected" if yearFilter === historicYear }}">
            <a class="govuk-tabs__tab" href="?year={{ historicYear }}">
              {{ historicYear }} scans
            </a>
          </li>
        {% endfor %}
        <li class="govuk-tabs__list-item {{ "govuk-tabs__list-item--selected" if yearFilter === "all" }}">
          <a class="govuk-tabs__tab" href="?year=all">
            All scans
          </a>
        </li>
      </ul>
    </div>
    <h3 class="govuk-heading-s">
      {% if not yearFilter %}
        Scans recorded this year
      {% elseif yearFilter === "all" %}
        All scans recorded
      {% else %}
        Scans recorded in {{ yearFilter }}
      {% endif %}
    </h3>

    <p>TODO: pagination</p>

    {% set rows = [] %}
    {% for scan in scanRows %}

      {# TODO: what permissions are needed? #}
      {% set actionLink %}
        {% if scan.caseNoteId %}
          <a href="#">View case note</a>
        {% elseif scan.source === "DPS" %}
          <a href="#">Add case note</a>
        {% endif %}
      {% endset %}

      {% set _ = rows.push([
        { text: scan.scanDateDescription },
        { text: scan.prisonDescription },
        { text: scan.justificationDescription },
        { html: resultTag(scan) },
        { text: scan.typeOfFindDescription | default("None", true) if scan.source === "DPS" else "" },
        { html: actionLink, classes: "scan-table__action-td" }
      ]) %}
    {% endfor %}
    {% if rows.length > 0 %}
      <div class="scan-table__container">
        {{ govukTable({
          head: [
            { text: "Date" },
            { text: "Establishment" },
            { text: "Reason" },
            { text: "Scan details", classes: "scan-table__details-th" },
            { text: "Items found" },
            { text: "Action", classes: "scan-table__action-th" }
          ],
          rows: rows,
          classes: "scan-table"
        }) }}
      </div>
    {% else %}
      {% if not yearFilter %}
        <p>No X-ray body scans have been recorded for this person in {{ now().getFullYear() }}.</p>
      {% elseif yearFilter === "all" %}
        <p>No X-ray body scans have been recorded for this person.</p>
      {% else %}
        <p>No X-ray body scans have been recorded for this person in {{ yearFilter }}.</p>
      {% endif %}
    {% endif %}

    <p>TODO: pagination</p>

  </section>

  <p><a href="{{ prisoner | prisonerProfileUrl }}">Return to the prisoner’s profile</a></p>

{% endblock %}
