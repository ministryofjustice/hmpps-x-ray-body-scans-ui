{% extends "partials/layout.njk" %}

{% from "govuk/components/details/macro.njk" import govukDetails %}

{% set pageTitle = applicationName + " – Error" %}
{% set breadcrumbs = [
  { text: 'Digital Prison Services', href: dpsHomeUrl }
] %}
{% if prisoner %}
  {% set _ = breadcrumbs.push(
    { text: prisoner.reversedDisplayName, href: prisoner | prisonerProfileUrl }
  ) %}
{% endif %}

{% block content %}
  <div class="govuk-grid-row">
    <div class="govuk-grid-column-two-thirds">
      <h1 class="govuk-heading-l">Sorry, there is a problem with the service</h1>
      <p>Try again later.</p>
    </div>
  </div>

  {% if not production and (error.message or error.stack) %}
    {% call govukDetails({ summaryText: "Error details" }) %}
      {% if error.message %}
        <p class="govuk-body-l">{{ error.message }}</p>
      {% endif %}
      <p>Status: {{ status }}</p>
      {% if error.data %}
        <p>Data:</p>
        <pre>
          {{- error.data | dump -}}
        </pre>
      {% endif %}
      {% if error.stack %}
        <p>Stack:</p>
        <pre>
          {{- error.stack -}}
        </pre>
      {% endif %}
    {% endcall %}
  {% endif %}
{% endblock %}
